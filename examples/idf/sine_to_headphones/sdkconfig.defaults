# Bluetooth Classic with A2DP and AVRCP; BLE off (its memory is released at init).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_AVRCP_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
# The Bluetooth stack makes the application larger than the default 1 MB partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_FREERTOS_HZ=1000
# The example writes the tone from app_main.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
